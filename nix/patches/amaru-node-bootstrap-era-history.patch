+/// Outcome of the local-first decision.
+///
+/// `UseLocal` is the only route that may skip the remote listing seam, and it carries snapshots
+/// taken from the discovered local collection itself.
+#[derive(Debug)]
+enum LocalFirst {
+    UseLocal(Vec<Snapshot>),
+    ListRemote,
+}
+
+/// Decide whether the already-discovered `local` collection alone satisfies `target_epoch`.
+///
+/// Authorising and supplying are one act: the snapshots returned are exactly the members of
+/// `local` that `select_bootstrap_snapshots` picked for the requested window, so no other
+/// collection can authorise a local success and none can be substituted for the result. Without
+/// an explicit target the latest epoch is only knowable from the remote index, so the decision
+/// defers rather than guessing from whatever happens to be on disk.
+fn decide_local_first(local: &[Snapshot], target_epoch: Option<Epoch>) -> LocalFirst {
+    let Some(target_epoch) = target_epoch else {
+        return LocalFirst::ListRemote;
+    };
+
+    match select_bootstrap_snapshots(local, Some(target_epoch)) {
+        Ok(selected) => LocalFirst::UseLocal(selected.into_iter().cloned().collect()),
+        Err(_) => LocalFirst::ListRemote,
+    }
+}
+
+/// The bootstrap snapshot discovery decision owner.
+///
+/// `list_remote` is the remote listing seam, yielding `(point, key)` pairs. Production binds it
+/// to S3; fixtures bind a recording double, so "this request never reached the network" is
+/// observable without network access. Every route to a remote request passes through it.
+///
+/// INV-095-CI2-SUCCESS-EXITS: the exact-local decision below is the only success exit before
+/// that seam. A second one — including a SAME-LINE-SECOND-EARLY-RETURN sharing a physical line
+/// with the first — is caught behaviourally, because some scenario then stops recording a call.
+async fn bootstrap_snapshots_with<F, Fut>(
+    network: NetworkName,
+    era_history: &EraHistory,
+    snapshots_dir: PathBuf,
+    target_epoch: Option<Epoch>,
+    list_remote: F,
+) -> Result<(PathBuf, Vec<Snapshot>), Box<dyn Error>>
+where
+    F: FnOnce() -> Fut,
+    Fut: Future<Output = Result<Vec<(String, String)>, Box<dyn Error>>>,
+{
+    let mut snapshots = local_snapshots(network, era_history, &snapshots_dir)?;
+
+    if let LocalFirst::UseLocal(selected) = decide_local_first(&snapshots, target_epoch) {
+        return Ok((snapshots_dir, selected));
+    }
+
+    for (point, key) in list_remote().await? {
+        push_snapshot(&mut snapshots, era_history, point, key)?;
+    }
+
     snapshots.sort_unstable_by_key(|snapshot| snapshot.epoch);
     snapshots.dedup_by_key(|snapshot| snapshot.epoch);

     Ok((snapshots_dir, snapshots))
 }

