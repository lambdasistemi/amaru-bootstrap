+    /// Issue 95: the local-first bootstrap snapshot decision.
+    ///
+    /// Every fixture drives `bootstrap_snapshots_with`, the same decision owner production
+    /// calls; only the bound remote listing seam differs. That seam records whether it was
+    /// invoked, so "this request never reached the network" is directly observable.
+    ///
+    /// INV-095-CI2-SAME-CODE: no fixture reimplements or mirrors the decision.
+    mod local_first {
+        use std::{cell::Cell, error::Error, fs, future::Future, path::Path, time::Duration};
+
+        use amaru_kernel::{Epoch, EraBound, EraHistory, EraName, EraParams, EraSummary, NetworkName, Slot};
+        use tempfile::{TempDir, tempdir};
+
+        use super::super::{Snapshot, bootstrap_snapshots_with, select_bootstrap_snapshots};
+
+        const NETWORK: NetworkName = NetworkName::Testnet(42);
+        const REMOTE_ERROR: &str = "remote listing refused";
+
+        /// One 5-slot Conway era starting at epoch 0, so slot `n` lands in epoch `n / 5`.
+        fn era_history() -> EraHistory {
+            let start = EraBound { time: Duration::from_secs(0), slot: Slot::from(0_u64), epoch: Epoch::from(0_u64) };
+            let params =
+                EraParams { epoch_size_slots: 5, slot_length: Duration::from_secs(1), era_name: EraName::Conway };
+            EraHistory::new(&[EraSummary { start, end: None, params }], Slot::from(0_u64))
+        }
+
+        /// The `<slot>.<hash>` point of a snapshot landing on the first slot of `epoch`.
+        fn point(epoch: u64) -> String {
+            format!("{}.{:064x}", epoch * 5, epoch)
+        }
+
+        /// The S3 object key the publisher would give that snapshot.
+        fn key(epoch: u64) -> String {
+            format!("{NETWORK}/{}{}", point(epoch), Snapshot::ARCHIVE_SUFFIX)
+        }
+
+        /// Stage `epochs` as plain `<point>.tar.zst` files; the local scan reads names only.
+        fn staged(epochs: &[u64]) -> TempDir {
+            let dir = tempdir().unwrap();
+            for epoch in epochs {
+                fs::write(dir.path().join(format!("{}{}", point(*epoch), Snapshot::ARCHIVE_SUFFIX)), b"").unwrap();
+            }
+            dir
+        }
+
+        /// How a fixture observes a snapshot's identity, and what staging `epoch` should yield.
+        fn identity(snapshot: &Snapshot) -> (Epoch, String, String) {
+            (snapshot.epoch, snapshot.point.clone(), snapshot.key.clone())
+        }
+
+        fn staged_identities(epochs: &[u64]) -> Vec<(Epoch, String, String)> {
+            epochs.iter().map(|epoch| (Epoch::from(*epoch), point(*epoch), key(*epoch))).collect()
+        }
+
+        /// Remote listing seam that records every invocation.
+        struct Remote {
+            calls: Cell<usize>,
+            result: Result<Vec<(String, String)>, &'static str>,
+        }
+
+        impl Remote {
+            fn listing(epochs: &[u64]) -> Self {
+                let entries = epochs.iter().map(|epoch| (point(*epoch), key(*epoch))).collect();
+                Remote { calls: Cell::new(0), result: Ok(entries) }
+            }
+
+            fn failing() -> Self {
+                Remote { calls: Cell::new(0), result: Err(REMOTE_ERROR) }
+            }
+
+            async fn list(&self) -> Result<Vec<(String, String)>, Box<dyn Error>> {
+                self.calls.set(self.calls.get() + 1);
