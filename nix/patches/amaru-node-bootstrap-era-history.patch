+        /// One 5-slot Conway era starting at epoch 0, so slot `n` lands in epoch `n / 5`.
+        fn era_history() -> EraHistory {
+            let start = EraBound { time: Duration::from_secs(0), slot: Slot::from(0_u64), epoch: Epoch::from(0_u64) };
+            let params =
