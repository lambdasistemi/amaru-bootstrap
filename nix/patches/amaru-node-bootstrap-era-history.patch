+            calls: Cell<usize>,
+            result: Result<Vec<(String, String)>, &'static str>,
+        }
+
+        impl Remote {
+            fn listing(epochs: &[u64]) -> Self {
+                let entries = epochs.iter().map(|epoch| (point(*epoch), key(*epoch))).collect();
+                Remote { calls: Cell::new(0), result: Ok(entries) }
+            }
+
+            fn failing() -> Self {
