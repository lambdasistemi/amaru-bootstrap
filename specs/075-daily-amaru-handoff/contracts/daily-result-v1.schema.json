{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lambdasistemi/amaru-bootstrap/specs/075-daily-amaru-handoff/contracts/daily-result-v1.schema.json",
  "title": "Daily Amaru reconciliation result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "observation_day",
    "result",
    "observed_sha",
    "pinned_sha"
  ],
  "properties": {
    "schema": {
      "const": "amaru-bootstrap-daily-result/v1"
    },
    "observation_day": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "result": {
      "enum": ["UNCHANGED", "HANDOFF"]
    },
    "observed_sha": {
      "$ref": "#/$defs/gitSha"
    },
    "pinned_sha": {
      "$ref": "#/$defs/gitSha"
    },
    "handoff": {
      "$ref": "#/$defs/handoff"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "UNCHANGED"
          }
        }
      },
      "then": {
        "not": {
          "required": ["handoff"]
        }
      },
      "else": {
        "required": ["handoff"]
      }
    }
  ],
  "$defs": {
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_tag", "asset_url", "asset_sha256"],
      "properties": {
        "release_tag": {
          "type": "string",
          "pattern": "^amaru-handoff-v1-[0-9a-f]{40}-[0-9a-f]{40}$"
        },
        "asset_url": {
          "type": "string",
          "pattern": "^https://github\\.com/lambdasistemi/amaru-bootstrap/releases/download/amaru-handoff-v1-[0-9a-f]{40}-[0-9a-f]{40}/handoff-v1\\.json$"
        },
        "asset_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
